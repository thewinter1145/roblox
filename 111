local function adminGetRank(plr, id)
	for _ = 1, 3 do
		local ok, res = pcall(function() return plr:GetRankInGroup(id) end)
		if ok then return tonumber(res) or 0 end
		task.wait(0.25)
	end
	return 0
end

local function adminGetRoleName(plr, id)
	for _ = 1, 2 do
		local ok, res = pcall(function() return plr:GetRoleInGroup(id) end)
		if ok and type(res) == "string" then return res end
		task.wait(0.25)
	end
	return ""
end

local function adminIsStaffName(s)
	local n = string.lower(tostring(s or ""))
	return n:find("admin") or n:find("moderator") or n:find("mod") or n:find("staff")
		or n:find("dev") or n:find("owner") or n:find("founder") or n:find("管理")
		or n:find("运营") or n:find("客服") or n:find("创始") or n:find("super")
end

local function adminLowestStaffRank(roles)
	local lowest = math.huge
	for _, role in ipairs(roles) do
		if adminIsStaffName(role.Name) then
			local r = tonumber(role.Rank) or 255
			if r < lowest then lowest = r end
		end
	end
	return lowest
end

local function adminResolve()
	adminGroupId = tonumber(_G.AA_AdminGroupId) or 0
	adminCreatorType, adminCreatorId = "", 0
	adminGroupName, adminThreshold = "", 0
	local ok, info = pcall(function() return MarketplaceService:GetProductInfo(game.PlaceId) end)
	if ok and type(info) == "table" and type(info.Creator) == "table" then
		adminCreatorType = tostring(info.Creator.CreatorType or "")
		adminCreatorId = tonumber(info.Creator.CreatorTargetId) or 0
		if adminCreatorType:find("Group") then
			if adminGroupId <= 0 then adminGroupId = adminCreatorId end
		else
			local desc = tostring(info.Description or "")
			local gid = desc:match("roblox%.com/groups/(%d+)")
			if adminGroupId <= 0 and gid then adminGroupId = tonumber(gid) or 0 end
		end
	end
	if adminGroupId > 0 then
		local okG, gi = pcall(function() return GroupService:GetGroupInfoAsync(adminGroupId) end)
		if okG and type(gi) == "table" then
			adminGroupName = tostring(gi.Name or "")
			if type(gi.Roles) == "table" then
				local r = adminLowestStaffRank(gi.Roles)
				if r < math.huge then adminThreshold = r end
			end
		end
	end
	local manual = tonumber(_G.AA_AdminMinRank) or 0
	if manual > 0 then adminThreshold = manual end
	if adminThreshold > 0 and adminThreshold < 2 then adminThreshold = 2 end
	adminResolved = true
end

local function adminBlacklistSet()
	local set = {}
	for piece in tostring(_G.AA_AdminBlacklist or ""):gmatch("[^,%s;]+") do
		set[piece] = true
	end
	return set
end

local function adminMarks(plr)
	local hits = {}
	local okA, attrs = pcall(function() return plr:GetAttributes() end)
	if okA and type(attrs) == "table" then
		for k, v in pairs(attrs) do
			local n = string.lower(tostring(k))
			if n:find("admin") or n:find("moderator") or n:find("staff") or n:find("permission") then
				if v == true or (type(v) == "number" and v > 0) then
					table.insert(hits, tostring(k))
				end
			end
		end
	end
	pcall(function()
		for _, key in ipairs({ "Admin", "IsAdmin", "isAdmin", "Moderator", "Staff", "Owner" }) do
			if plr:FindFirstChild(key) then table.insert(hits, key) end
		end
	end)
	return hits
end

local function adminCheckPlayer(plr)
	if plr == LP then return nil end
	local bl = adminBlacklistSet()
	if bl[tostring(plr.UserId)] or bl[plr.Name] then return "已知名单" end
	if not adminCreatorType:find("Group") and adminCreatorId > 0 and plr.UserId == adminCreatorId then
		return "游戏所有者"
	end
	if adminGroupId > 0 then
		local rank = adminGetRank(plr, adminGroupId)
		if rank > 0 then
			local roleName = adminGetRoleName(plr, adminGroupId)
			if adminIsStaffName(roleName) then
				return "群组职级 " .. roleName .. " (" .. tostring(rank) .. ")"
			end
			if adminThreshold > 0 and rank >= adminThreshold then
				return "群组排名 " .. tostring(rank) .. " / 阈值 " .. tostring(adminThreshold)
			end
		end
	end
	if _G.AA_AdminCheckMarks then
		local marks = adminMarks(plr)
		if #marks > 0 then return "权限标记 " .. table.concat(marks, ",") end
	end
	return nil
end

