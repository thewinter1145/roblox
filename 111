local function adminScan()
	if not _G.AA_AdminWatch then return end
	if not adminResolved then pcall(adminResolve) end
	local manual = tonumber(_G.AA_AdminMinRank) or 0
	if manual > 0 then adminThreshold = manual end
	local snapshot = {}
	local pending = 0
	for _, plr in ipairs(Players:GetPlayers()) do table.insert(snapshot, plr) end
	for _, plr in ipairs(snapshot) do
		if not adminChecked[plr.UserId] then
			pending = pending + 1
			task.spawn(function()
				local ok, reason = pcall(adminCheckPlayer, plr)
				if ok then
					adminChecked[plr.UserId] = true
					if reason then
						adminFound[plr.UserId] = { name = plr.Name, id = plr.UserId, reason = reason }
					end
				end
			end)
		end
	end
	if pending > 0 then task.wait(1.2) end
	local alive = {}
	for _, plr in ipairs(Players:GetPlayers()) do alive[plr.UserId] = true end
	for uid in pairs(adminFound) do
		if not alive[uid] then adminFound[uid] = nil end
	end
	local lines = {}
	for _, info in pairs(adminFound) do
		table.insert(lines, info.name .. " (" .. tostring(info.id) .. ") · " .. info.reason)
	end
	table.sort(lines)
	_G.AA_AdminList = (#lines > 0) and table.concat(lines, "\n") or "无"
	_G.AA_AdminState = (#lines > 0) and ("发现 " .. tostring(#lines) .. " 位拥有权限的管理员") or "未发现拥有权限的管理员"
	_G.AA_AdminPresent = (#lines > 0)
	_G.AA_AdminGroupInfo = "群组 " .. tostring(adminGroupId) .. " " .. adminGroupName
		.. " · 职级阈值 " .. tostring(adminThreshold) .. " · 创建者 " .. adminCreatorType .. " " .. tostring(adminCreatorId)
	if #lines > 0 then
		if not _G.AA_AdminWarned then
			_G.AA_AdminWarned = true
			adminNotify(_G.AA_AdminState .. "\n" .. _G.AA_AdminList)
		end
		if _G.AA_AdminAutoKick and not adminKickActive then
			adminKickActive = true
			task.spawn(function()
				local left = math.max(0, tonumber(_G.AA_AdminKickDelay) or 5)
				while left > 0 do
					_G.AA_AdminCountdown = math.ceil(left)
					task.wait(1)
					if not _G.AA_AdminAutoKick or not _G.AA_AdminWatch or not _G.AA_AdminPresent then
						_G.AA_AdminCountdown = 0
						adminKickActive = false
						return
					end
					left = left - 1
				end
				_G.AA_AdminCountdown = 0
				pcall(function() LP:Kick("Session ended") end)
			end)
		end
	else
		_G.AA_AdminWarned = false
		_G.AA_AdminCountdown = 0
	end
end
_G.AA_AdminScan = adminScan
_G.AA_AdminRecheck = function() adminChecked = {} pcall(adminScan) end
_G.AA_AdminResolve = function() adminResolved = false adminChecked = {} pcall(adminResolve) pcall(adminScan) end

task.spawn(function()
	task.wait(2)
	while true do
		pcall(adminScan)
		task.wait(5)
	end
end)

