local function tiPolygon(center, radius, sides, rot)
	local pts = {}
	for i = 1, sides do
		local a = (i - 1) * (2 * math.pi / sides) - (math.pi / 2) + rot
		table.insert(pts, Vector2.new(
			center.X + radius * math.cos(a),
			center.Y + radius * math.sin(a)))
	end
	return pts
end

local function tiColor()
	local mode, sp = _G.AA_TIColorMode, _G.AA_TIColorSpeed or 3
	if mode == "彩虹" then
		return Color3.fromHSV((tick() * sp * 0.1) % 1, 1, 1)
	elseif mode == "渐变" then
		return _G.AA_TIColor1:Lerp(_G.AA_TIColor2, (math.sin(tick() * sp) + 1) / 2)
	end
	return _G.AA_TIColor1
end

local function drawTargetIndicator(head, name, dist, exposed)
	if not (hasTI or tiHLReady) then return end
	if not (_G.AA_ShowTarget and _G.AA_Enabled) then hideTargetIndicator(); return end
	local c = workspace.CurrentCamera or cam
	if not (c and head and head.Parent) then hideTargetIndicator(); return end
	local ok, v = pcall(function() return c:WorldToViewportPoint(head.Position) end)
	if not ok or not v or v.Z <= 0 then hideTargetIndicator(); return end
	local pos = Vector2.new(v.X, v.Y)

	local col = tiColor()
	local radius = _G.AA_TIRadius or 20
	if exposed and _G.AA_TIGreenOnExposed then
		col = Color3.fromRGB(0, 255, 0)
		radius = radius * 0.6
	end
	local scale = 1
	if _G.AA_TIBreath then
		local mn, mx = _G.AA_TIBreathMin or 0.8, _G.AA_TIBreathMax or 1.2
		scale = mn + (mx - mn) * (math.sin(tick() * (_G.AA_TIBreathSpeed or 1) * math.pi * 2) * 0.5 + 0.5)
	end
	local rot = 0
	if _G.AA_TIRotate then
		rot = (tick() * (_G.AA_TIRotSpeed or 1)) % (math.pi * 2)
	end
	local r = radius * scale
	local style = _G.AA_TIStyle or "Circle"
	hideTargetIndicator()
	if not hasTI then
		pcall(function()
			if tiHighlight and head.Parent then
				tiHighlight.Adornee = head.Parent
				tiHighlight.OutlineColor = col
				tiHighlight.FillColor = col
				_G.AA_Stats.tiDraw = _G.AA_Stats.tiDraw + 1
			end
		end)
		return
	end

	local function setLine(i, from, to)
		local ln = tiLines[i]
		if not ln then return end
		ln.Visible = true; ln.Color = col
		ln.From = from; ln.To = to
	end

	if style == "Circle" then
		tiCircle.Visible = true
		tiCircle.Color = col
		tiCircle.Radius = r
		tiCircle.Position = pos
	elseif style == "Triangle" then
		local p = tiPolygon(pos, r, 3, rot)
		for i = 1, 3 do setLine(i, p[i], p[i % 3 + 1]) end
	elseif style == "Pentagram" then
		local p = tiPolygon(pos, r, 5, rot)
		local order = { 1, 3, 5, 2, 4 }
		for i = 1, 5 do setLine(i, p[order[i]], p[order[i % 5 + 1]]) end
	elseif style == "十字准星" then
		local len = (_G.AA_TICrosshairLength or 20) * scale
		local gap = (_G.AA_TICrosshairGap or 5) * scale
		local co, si = math.cos(rot), math.sin(rot)
		local function rv(x) return Vector2.new(x.X * co - x.Y * si, x.X * si + x.Y * co) end
		local pts = {
			{ rv(Vector2.new(0, -len)) + pos, rv(Vector2.new(0, -gap)) + pos },
			{ rv(Vector2.new(0,  len)) + pos, rv(Vector2.new(0,  gap)) + pos },
			{ rv(Vector2.new(-len, 0)) + pos, rv(Vector2.new(-gap, 0)) + pos },
			{ rv(Vector2.new( len, 0)) + pos, rv(Vector2.new( gap, 0)) + pos },
		}
		for i = 1, 4 do setLine(i, pts[i][1], pts[i][2]) end
	elseif style == "三线准星" then
		local len = (_G.AA_TIThreeLineLength or 20) * scale
		local gap = (_G.AA_TIThreeLineGap or 5) * scale
		for i = 1, 3 do
			local a = rot + (i - 1) * (math.pi * 2 / 3)
			local d = Vector2.new(math.cos(a), math.sin(a))
			setLine(i, pos + d * gap, pos + d * len)
		end
	end

	if tiText and _G.AA_TIShowText then
		pcall(function()
			tiText.Visible = true
			tiText.Color = col
			tiText.Text = string.format("目标 %s · %dm", tostring(name or "?"), math.floor(dist or 0))
			tiText.Position = Vector2.new(pos.X, pos.Y + r + 14)
		end)
	end
	_G.AA_Stats.tiDraw = _G.AA_Stats.tiDraw + 1
end

