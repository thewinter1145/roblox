_G.AA_AutoFireConn = RunService.Heartbeat:Connect(function()
    if not _G.AA_AutoFire or not AA_Shoot then return end
    local now = os.clock()
    local rate = math.max(0, tonumber(_G.AA_AutoFireRate) or 0)
    if rate > 0 and (now - (_G.AA_AutoFireLast or 0)) < rate then return end

    local origin = aaOrigin()
    if not origin then return end
    local targets = aaTargets(origin)
    if #targets == 0 then return end

    local ok = pcall(aaFire, origin, targets)
    if not ok then
        _G.AA_Stats.autoFireErr = (_G.AA_Stats.autoFireErr or 0) + 1
        return
    end
    for _, t in ipairs(targets) do
        if t._end then aaTracer(origin, t._end) end
        if t._pred then aaPredMark(t._pred) end
    end
    _G.AA_Stats.autoFire = (_G.AA_Stats.autoFire or 0) + #targets
    _G.AA_AutoFireLast = now
end)
_G.AA_AutoFireOnce = function()
    local o = aaOrigin()
    if not o or not AA_Shoot then return false end
    local ts = aaTargets(o)
    if #ts == 0 then return false end
    return pcall(aaFire, o, ts)
end

