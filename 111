AA_InitFlag("AA_AutoFirePingScale", 0.5)        -- 延迟系数(ping 为往返, 0.5 = 单程)
AA_InitFlag("AA_AutoFireSmooth",    0.35)       -- 速度平滑系数(越大越灵敏, 越抖)
