-- [缝合] 自动射击模块 / R_GunEngine.Shoot
--   抓包: Shoot:FireServer({ { Origin = Vector3, EndPosition = Vector3 } })
--   实测 |EndPosition - Origin| = 1000.000 => EndPosition 是"固定长度射线终点",
--   不是命中点; 保持长度、只把方向指向敌人头部即可。
--   复用本脚本: getRole / hostileLevel / collectCandidates / findTarget /
--              _G.AA_Target / screenInFOV / isExposed / aimPoint /
--              muzzleWorldPos (枪口 = 抓包里的 Origin)
--====================================================================--
AA_InitFlag("AA_AutoFire",          false)      -- 独立总开关 (热键 RightShift)
AA_InitFlag("AA_AutoFireRate",      0)          -- 射击间隔(秒), 0 = 每帧
AA_InitFlag("AA_AutoFireRayLen",    1000)       -- 包内射线长度(抓包实测 1000)
AA_InitFlag("AA_AutoFireEndMode",   "固定长度") -- "固定长度" | "命中点"
AA_InitFlag("AA_AutoFireTargets",   1)          -- 一次包里打几个目标
AA_InitFlag("AA_AutoFireTracer",    true)       -- 绘制弹道
AA_InitFlag("AA_AutoFireWallCheck", true)       -- 不隔墙射击
AA_InitFlag("AA_AutoFireRelax",     false)      -- 自身阵营未识别时的兜底
AA_InitFlag("AA_AutoFireNeedLock",  true)       -- 仅当辅助锁定目标(_G.AA_Target)才开火
