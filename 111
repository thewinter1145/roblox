local muzzleState = nil

local muzzleScanClock = 0
local muzzleCached = nil
local function deepMuzzle(root)
    if not root then return nil end
    local ok, list = pcall(function() return root:GetDescendants() end)
    if not ok or not list then return nil end
    local fb = nil
    for _, v in ipairs(list) do
        local nm = (v.Name or ""):lower()
        if nm:find("muzzle") or nm:find("firepoint") or nm:find("bulletpoint") then
            if v:IsA("Attachment") or v:IsA("BasePart") then return v end
        end
        if v:IsA("Attachment") and not fb then fb = v end
    end
    return fb
end
local function scanCamModels(c)
    if not c then return nil end
    local ok, kids = pcall(function() return c:GetChildren() end)
    if not ok or not kids then return nil end
    for _, v in ipairs(kids) do
        if v:IsA("Model") then
            local m = v:FindFirstChild("Muzzle")
            if not m then
                local h = v:FindFirstChild("Handle")
                if h then m = h:FindFirstChild("Muzzle") end
            end
            if m then return m end
        end
    end
    return nil
end
local function getGunMuzzle()
    local ch = LP.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then
                local h = t:FindFirstChild("Handle")
                local m = (h and h:FindFirstChild("Muzzle")) or t:FindFirstChild("Muzzle")
                if m then return m end
            end
        end
    end
    local liveCam = workspace.CurrentCamera
    local m1 = scanCamModels(cam) or scanCamModels(liveCam)
    if m1 then return m1 end
    local now = os.clock()
    if muzzleCached and muzzleCached.Parent and (now - muzzleScanClock) < 1 then return muzzleCached end
    muzzleScanClock = now
    muzzleCached = deepMuzzle(ch) or deepMuzzle(cam)
    if not muzzleCached and liveCam and liveCam ~= cam then muzzleCached = deepMuzzle(liveCam) end
    return muzzleCached
end

local function ensureMuzzleState()
    local m = getGunMuzzle()
    _G.AA_MuzzleFound = m ~= nil
    if not m then return nil end
    if muzzleState and muzzleState.muzzle == m and m.Parent then return muzzleState end
    if muzzleState and muzzleState.aimed then
        pcall(function()
            if muzzleState.muzzle.Parent then muzzleState.muzzle.CFrame = muzzleState.orig end
        end)
    end
    local ok, cf = pcall(function() return m.CFrame end)
    if not ok then return nil end
    muzzleState = { muzzle = m, orig = cf, isAtt = m:IsA("Attachment"), aimed = false }
    return muzzleState
end

local function muzzleWorldPos()
    local s = ensureMuzzleState()
    if not s then return nil end
    local ok, pos = pcall(function()
        if s.isAtt then
            local p = s.muzzle.Parent
            if p and p.CFrame then return p.CFrame * s.orig.Position end
            return s.muzzle.WorldCFrame.Position
        end
        return s.muzzle.CFrame.Position
    end)
    if ok and pos then return pos end
    return nil
end

local function restoreMuzzle()
    if not muzzleState or not muzzleState.aimed then return end
    pcall(function()
        if muzzleState.muzzle.Parent then muzzleState.muzzle.CFrame = muzzleState.orig end
    end)
    muzzleState.aimed = false
    _G.AA_Stats.restored = _G.AA_Stats.restored + 1
end

local function aimMuzzleAt(headPos)
    local s = ensureMuzzleState()
    if not s then return false end
    local m = s.muzzle
    local got, origWorld = pcall(function()
        if s.isAtt then
            local p = m.Parent
            local pc = p and p.CFrame
            if pc then return pc * s.orig end
            return m.WorldCFrame
        end
        return s.orig
    end)
    if not got or not origWorld then return false end
    local want = CFrame.lookAt(origWorld.Position, headPos, origWorld.UpVector)
    local ok = pcall(function()
        if s.isAtt then
            local p = m.Parent
            local pc = p and p.CFrame
            if pc then
                m.CFrame = pc:ToObjectSpace(want)
            else
                m.CFrame = m.WorldCFrame:ToObjectSpace(want) * m.CFrame
            end
        else
            m.CFrame = want
        end
    end)
    if ok then
        s.aimed = true
        _G.AA_Stats.aimSet = _G.AA_Stats.aimSet + 1
    end
    return ok
end

local SHIELD_WORDS = { "shield", "barrier", "bubble", "dome", "aura", "forcefield", "protect", "ward" }
local function isShieldLike(inst)
    if not inst then return false end
    local ok, res = pcall(function()
        if inst:IsA("ForceField") then return true end
        local nm = (inst.Name or ""):lower()
        for _, w in ipairs(SHIELD_WORDS) do
            if nm:find(w, 1, true) then return true end
        end
        if inst:GetAttribute("IsShield") or inst:GetAttribute("Shield") or inst:GetAttribute("ForceField") then return true end
        local m = inst:FindFirstAncestorOfClass("Model")
        if m and m ~= LP.Character then
            local mn = (m.Name or ""):lower()
            for _, w in ipairs(SHIELD_WORDS) do
                if mn:find(w, 1, true) then return true end
            end
            if m:GetAttribute("IsShield") or m:GetAttribute("Shield") then return true end
        end
        if inst:IsA("BasePart") then
            if inst.Transparency >= 0.6 and not inst.CanCollide then return true end
            if (inst.Material == Enum.Material.ForceField or inst.Material == Enum.Material.Neon) and inst.Transparency >= 0.35 then return true end
        end
        return false
    end)
    return ok and res == true
end

local function isSpectatorPart(inst)
    if not _G.AA_IgnoreSpectator or not inst then return false end
    local ok, res = pcall(function()
        local m = inst:FindFirstAncestorOfClass("Model")
        if not m then return false end
        local pl = Players:GetPlayerFromCharacter(m)
        if pl and getRole(pl) == "Spectator" then return true end
        return m:GetAttribute("Role") == "Spectator"
    end)
    return ok and res == true
end

local function setExclude(rp)
    if not pcall(function() rp.FilterType = Enum.RaycastFilterType.Exclude end) then
        pcall(function() rp.FilterType = Enum.RaycastFilterType.Blacklist end)
    end
end

local function collectShieldIgnores()
    local out, seen = {}, {}
    local function add(x)
        if x and not seen[x] and #out < 200 then seen[x] = true; table.insert(out, x) end
    end
    local function consider(x)
        if not x then return end
        if isShieldLike(x) then add(x) return end
        pcall(function()
            if x:IsA("BasePart") and x.Transparency >= 0.5 then add(x) end
        end)
    end
    pcall(function()
        for _, top in ipairs(workspace:GetChildren()) do consider(top) end
    end)
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            local ch = p.Character
            if ch then
                local okK, kids = pcall(function() return ch:GetChildren() end)
                if okK and type(kids) == "table" then
                    for _, k in ipairs(kids) do consider(k) end
                end
            end
        end
    end)
    pcall(function()
        local budget = 400
        for _, top in ipairs(workspace:GetChildren()) do
            local okK, kids = pcall(function() return top:GetChildren() end)
            if okK and type(kids) == "table" then
                for _, k in ipairs(kids) do
                    consider(k)
                    budget = budget - 1
                    if budget <= 0 then break end
                end
            end
            if budget <= 0 then break end
        end
    end)
    return out
end

local function aimPartNow()
    local t = _G.AA_Target
    if not t or not t.head then return nil end
    local h = t.head
    if h.Parent and h:IsA("BasePart") then return h end
    return nil
end

_G.AA_LastRayHit = 0
local hookReady = false
local oldNamecall = nil
pcall(function()
    if type(hookmetamethod) ~= "function" then return end
    if type(getnamecallmethod) ~= "function" then return end
    local nc = type(newcclosure) == "function" and newcclosure or function(f) return f end
    local hasCaller = type(checkcaller) == "function"
    local hasScript = type(getcallingscript) == "function"
    oldNamecall = hookmetamethod(game, "__namecall", nc(function(...)
        local self = ...
        local okM, method = pcall(getnamecallmethod)
        if not okM or not oldNamecall then return oldNamecall(...) end
        if method ~= "Raycast" or self ~= workspace then return oldNamecall(...) end
        if _G.AA_InDetectRay then return oldNamecall(...) end
        if not _G.AA_Enabled or not _G.AA_MuzzleAim or not _G.AA_RayHook then
            return oldNamecall(...)
        end
        if hasCaller and _G.AA_RayCallerFilter then
            local okC, isSelf = pcall(checkcaller)
            if okC and isSelf then return oldNamecall(...) end
        end
        if hasScript then
            local okS, cs = pcall(getcallingscript)
            if okS and cs and (cs.Name == "ControlScript" or cs.Name == "ControlModule") then
                return oldNamecall(...)
            end
        end
        if _G.AA_AimMethod == "Muzzle" then return oldNamecall(...) end
        local part = aimPartNow()
        if not part then return oldNamecall(...) end
        local args = { select(2, ...) }
        local origin, dir = args[1], args[2]
        local okMag, mag = pcall(function() return dir.Magnitude end)
        if not okMag or type(mag) ~= "number" or mag <= 0 then return oldNamecall(...) end
        if _G.AA_RayLenFilter then
            local base = _G.AA_RayLen
            local tol = _G.AA_RayLenTol
            if mag < base * (1 - tol) or mag > base * (1 + tol) then
                return oldNamecall(...)
            end
        end
        local okDir, newDir = pcall(function()
            return CFrame.lookAt(origin, part.Position).LookVector * mag
        end)
        if not okDir or not newDir then return oldNamecall(...) end
        args[2] = newDir
        if _G.AA_ShieldPierce and not _G.AA_ForceInclude then
            local okSh, o2, d2 = pcall(function()
                local base = args[3]
                local mode = _G.AA_ShieldPierceMode or "排除护盾"
                local o, d = args[1], newDir
                if mode == "起点传送" then
                    local u = d.Unit
                    o = part.Position - u * 3
                    d = (part.Position - o).Unit * mag
                end
                local list, seen = {}, {}
                local function addIg(x)
                    if x and not seen[x] then seen[x] = true; table.insert(list, x) end
                end
                local okBase, baseList = pcall(function()
                    if base and base.FilterDescendantsInstances then return base.FilterDescendantsInstances end
                end)
                if okBase and type(baseList) == "table" then
                    for _, x in ipairs(baseList) do addIg(x) end
                end
                if LP.Character then addIg(LP.Character) end
                if type(_G.AA_ShieldIgnores) == "table" then
                    for _, x in ipairs(_G.AA_ShieldIgnores) do addIg(x) end
                end
                local okSet = false
                if base then
                    okSet = pcall(function()
                        setExclude(base)
                        base.FilterDescendantsInstances = list
                    end)
                end
                if not okSet then
                    local rp = RaycastParams.new()
                    setExclude(rp)
                    rp.FilterDescendantsInstances = list
                    args[3] = rp
                end
                _G.AA_Stats.shieldHits = (_G.AA_Stats.shieldHits or 0) + 1
                return o, d
            end)
            if okSh and o2 and d2 then args[1], args[2] = o2, d2 end
        end
        if _G.AA_ForceInclude then
            local okP, p = pcall(function()
                local rp = RaycastParams.new()
                rp.FilterType = Enum.RaycastFilterType.Include
                rp.FilterDescendantsInstances = { part.Parent }
                return rp
            end)
            if okP and p then args[3] = p end
        end
        _G.AA_Stats.hookHits = (_G.AA_Stats.hookHits or 0) + 1
        _G.AA_LastRayHit = os.clock()
        return oldNamecall(self, args[1], args[2], args[3])
    end))
    hookReady = oldNamecall ~= nil
end)
_G.AA_HookReady = hookReady

local function rayVerified()
    if not hookReady or not _G.AA_RayHook then return false end
    if _G.AA_AimMethod == "Muzzle" then return false end
    local last = tonumber(_G.AA_LastRayHit) or 0
    if last <= 0 then return false end
    return (os.clock() - last) < 20
end
_G.AA_RayVerified = rayVerified

local function useRayHook()
    return (_G.AA_AimMethod ~= "Muzzle") and _G.AA_RayHook and hookReady
end

local rayCache = {}

local function isExposed(part, targetChar)
    if not _G.AA_AdvancedRay then return true end
    if not part or not targetChar then return false end
    local now = os.clock()
    local c = rayCache[targetChar]
    if c and (now - c.t) < 0.12 then return c.ok end

    local origin
    if _G.AA_RayFromMuzzle then origin = muzzleWorldPos() end
    if not origin and LP.Character then
        local h = LP.Character:FindFirstChild("Head")
        if h then origin = h.Position end
    end
    if not origin and cam then origin = cam.CFrame.Position end
    if not origin then return false end

    local dir = part.Position - origin
    local dist = dir.Magnitude
    local pierce = _G.AA_WallPierceDist or 0.5
    local myDist = dist
    pcall(function()
        local ch = LP.Character
        local myHRP = ch and ch:FindFirstChild("HumanoidRootPart")
        local tHRP = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
        local a = myHRP and myHRP.Position or origin
        local b = tHRP and tHRP.Position or part.Position
        local dx, dz = a.X - b.X, a.Z - b.Z
        myDist = math.sqrt(dx * dx + dz * dz)
    end)
    local exposed = (myDist <= pierce) or (dist < 0.5)
    if not exposed then
        local unit = dir / dist
        local params = RaycastParams.new()
        if not pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end) then
            pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
        end
        local ignore = {}
        if LP.Character then table.insert(ignore, LP.Character) end
        table.insert(ignore, targetChar)
        if cam then table.insert(ignore, cam) end
        local strict = _G.AA_WallCheck
        local cur, left = origin, dist
        for _ = 1, 10 do
            params.FilterDescendantsInstances = ignore
            local r
            local okRay = pcall(function()
                _G.AA_InDetectRay = true
                r = workspace:Raycast(cur, unit * left, params)
                _G.AA_InDetectRay = nil
            end)
            if not okRay then _G.AA_InDetectRay = nil r = nil end
            _G.AA_Stats.rays = _G.AA_Stats.rays + 1
            if not r or not r.Instance then exposed = true; break end
            local hit = r.Instance
            if hit:IsDescendantOf(targetChar) then exposed = true; break end
            local transparent = false
            pcall(function() transparent = (hit.Transparency >= 0.5) or (hit.CanCollide == false) end)
            local leftAfter = (part.Position - r.Position).Magnitude
            local passSpec = isSpectatorPart(hit)
            local maxTran = _G.AA_TransparentMaxDist or 60
            local passTran = (not strict) and _G.AA_IgnoreTransparent and transparent and (leftAfter <= maxTran)
            if passSpec then
                _G.AA_Stats.specPass = (_G.AA_Stats.specPass or 0) + 1
            end
            if passTran then
                _G.AA_Stats.tranPass = (_G.AA_Stats.tranPass or 0) + 1
            end
            if passSpec or passTran then
                table.insert(ignore, hit)
                cur = r.Position + unit * 0.05
                left = (part.Position - cur).Magnitude
                if left <= 0.1 then exposed = true; break end
            else
                exposed = false; break
            end
        end
    end

    if exposed then _G.AA_Stats.exposed = _G.AA_Stats.exposed + 1
    else _G.AA_Stats.blocked = _G.AA_Stats.blocked + 1 end
    rayCache[targetChar] = { ok = exposed, t = now }
    if _G.AA_Stats.rays % 200 == 0 then
        local n = 0
        for k, v in pairs(rayCache) do
            if now - v.t > 3 then rayCache[k] = nil else n = n + 1 end
        end
        if n > 120 then rayCache = {} end
    end
    return exposed
end

