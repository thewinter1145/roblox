UIBox:AddToggle("AAWatermark", { Text = "显示水印", Default = false }):OnChanged(function(Value)
	if Value and Library.AddDraggableLabel and not watermark then
		pcall(function() watermark = Library:AddDraggableLabel("Panel v5") end)
	end
	if watermark and watermark.SetVisible then
		pcall(function() watermark:SetVisible(Value) end)
	end
end)

if ThemeManager and SaveManager then
	pcall(function()
		ThemeManager:SetLibrary(Library)
		SaveManager:SetLibrary(Library)
		SaveManager:IgnoreThemeSettings()
		SaveManager:SetIgnoreIndexes({ "AAEnabledKey" })
		SaveManager:SetFolder("PanelV5/Configs")
		SaveManager:BuildConfigSection(Tabs["UI Settings"])
		ThemeManager:ApplyToTab(Tabs["UI Settings"])
		SaveManager:LoadAutoloadConfig()
	end)
end

pcall(function() Library:Notify("已加载", 5) end)

