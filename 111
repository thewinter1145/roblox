    diHpText.TextTransparency = 1
    diHpText.TextXAlignment = Enum.TextXAlignment.Left
    diHpText.TextYAlignment = Enum.TextYAlignment.Top
    diHpText.ZIndex = 104
    diHpText.Parent = diContainer

    local diBarBg = Instance.new("Frame")
    diBarBg.Size = UDim2.new(1, -80, 0, 7)
    diBarBg.Position = UDim2.new(0, 56, 0, 42)
    diBarBg.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    diBarBg.BackgroundTransparency = 1
    diBarBg.BorderSizePixel = 0
    diBarBg.ZIndex = 102
    diBarBg.Parent = diContainer
    Instance.new("UICorner", diBarBg).CornerRadius = UDim.new(0, 3)
    local diBarFill = Instance.new("Frame")
    diBarFill.Size = UDim2.new(1, 0, 1, 0)
    diBarFill.BackgroundColor3 = Color3.fromRGB(92, 216, 102)
    diBarFill.BackgroundTransparency = 1
    diBarFill.BorderSizePixel = 0
    diBarFill.ZIndex = 103
    diBarFill.Parent = diBarBg
    Instance.new("UICorner", diBarFill).CornerRadius = UDim.new(0, 3)

    local diState = "collapsed"
    local diTweens = {}
    local diTargetKey = nil
    local diAvatarCache = {}
    local diAvatarLoading = {}
    local diPending = nil
    local diHp, diMaxHp, diDist = -1, -1, -1
    local diLastTick = 0

    local function diTweenProp(obj, props, dur, style, dir)
        local tm = diTweens[obj] or {}
        for prop, goal in pairs(props) do
            if tm[prop] then tm[prop]:Cancel() end
            local t = DI_TweenService:Create(obj, TweenInfo.new(dur or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), { [prop] = goal })
            t:Play()
            tm[prop] = t
        end
        diTweens[obj] = tm
    end

    local diFadeItems = {
        { diAvatarBg, "bg" }, { diAvatarRing, "stroke" }, { diAvatar, "image" },
        { diName, "text" }, { diUser, "text" }, { diStatus, "text" }, { diHpText, "text" },
        { diBarBg, "bg" }, { diBarFill, "bg" },
    }
    local function diFadeContent(toTrans, dur)
        for _, item in ipairs(diFadeItems) do
            local obj, kind = item[1], item[2]
            if kind == "text" then diTweenProp(obj, { TextTransparency = toTrans }, dur)
            elseif kind == "image" then diTweenProp(obj, { ImageTransparency = toTrans }, dur)
            elseif kind == "stroke" then diTweenProp(obj, { Transparency = toTrans }, dur)
            else diTweenProp(obj, { BackgroundTransparency = toTrans }, dur) end
        end
    end

    local function diHealthColor(ratio)
        if ratio > 0.6 then return Color3.fromRGB(92, 216, 102) end
        if ratio > 0.3 then return Color3.fromRGB(240, 196, 60) end
        return Color3.fromRGB(236, 66, 66)
    end

    local function diLoadAvatar(userId)
        if diAvatarLoading[userId] then return end
        diAvatarLoading[userId] = true
        task.spawn(function()
            local url = ""
            for _ = 1, 3 do
                local ok, content, isReady = pcall(Players.GetUserThumbnailAsync, Players, userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                if ok and type(content) == "string" and content ~= "" and isReady then url = content break end
                task.wait(0.8)
            end
            diAvatarLoading[userId] = nil
            if url ~= "" then
                diAvatarCache[userId] = url
                if diTargetKey == "P" .. tostring(userId) then
                    diAvatar.Image = url
                    diTweenProp(diAvatar, { ImageTransparency = 0 }, 0.2)
                end
            end
        end)
    end

    local function diRenderHp()
        diHpText.Text = string.format("HP %d/%d · %dm", diHp, diMaxHp, math.max(0, diDist))
    end

    local function diSetValues(rec, humanoid)
        local maxHealth = humanoid and humanoid.MaxHealth or 1
        local health = humanoid and humanoid.Health or 0
        local ratio = maxHealth > 0 and math.clamp(health / maxHealth, 0, 1) or 0
        local h, mh, ds = math.floor(health), math.floor(maxHealth), math.floor(rec.dist or 0)
        if h ~= diHp or mh ~= diMaxHp then
            diHp, diMaxHp = h, mh
            diTweenProp(diBarFill, { Size = UDim2.new(ratio, 0, 1, 0) }, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
            diTweenProp(diBarFill, { BackgroundColor3 = diHealthColor(ratio) }, 0.25)
        end
        if ds ~= diDist then diDist = ds end
        diRenderHp()
    end

    local function diApply(rec, player, humanoid)
        local info = DI_ROLE[rec.role]
        if player and player:IsA("Player") then
            diName.Text = tostring(player.DisplayName ~= "" and player.DisplayName or player.Name)
            diUser.Text = "@" .. tostring(player.Name) .. (info and (" · " .. info.name) or "")
            local uid = player.UserId
            local cached = diAvatarCache[uid]
            diAvatar.Image = cached or ""
            if not cached then diLoadAvatar(uid) end
        else
            diName.Text = tostring(rec.char.Name)
            diUser.Text = (info and (info.name .. " · NPC") or "NPC")
            diAvatar.Image = ""
        end
        diAvatarRing.Color = info and info.color or Color3.fromRGB(255, 255, 255)
        local locked = (_G.AA_Target == rec)
        diStatus.Text = locked and "锁定中" or "目标信息"
        diStatus.TextColor3 = locked and Color3.fromRGB(150, 230, 160) or Color3.fromRGB(170, 175, 185)
        diHp, diMaxHp, diDist = -1, -1, -1
        diSetValues(rec, humanoid)
    end

    local function diToBall()
        _G.AA_IslandShown = false
        if diState == "collapsed" then return end
        diState = "collapsed"
        diTargetKey = nil
        if diPending then pcall(task.cancel, diPending) diPending = nil end
        diFadeContent(1, 0.12)
        diTweenProp(diContainer, { Size = UDim2.fromOffset(COLLAPSED, COLLAPSED), BackgroundColor3 = Color3.fromRGB(38, 42, 52), BackgroundTransparency = 0.1 }, 0.3)
        diTweenProp(diCorner, { CornerRadius = UDim.new(0.5, 0) }, 0.3)
        diTweenProp(diReflect, { BackgroundTransparency = 1 }, 0.18)
        diTweenProp(diReflectGrad, { Offset = Vector2.new(-0.18, 0) }, 0.22)
        diTweenProp(diHiStroke, { Transparency = 0.55 }, 0.2)
        diTweenProp(diShadowStroke, { Transparency = 1 }, 0.2)
    end

    local function diToIsland()
        _G.AA_IslandShown = true
        if diState == "expanded" then return end
        diState = "expanded"
        diTweenProp(diContainer, { Size = UDim2.fromOffset(EXP_W, EXP_H), BackgroundColor3 = Color3.fromRGB(44, 48, 57), BackgroundTransparency = 0.28 }, 0.34)
        diTweenProp(diCorner, { CornerRadius = ISLAND_CORNER }, 0.34)
        diTweenProp(diReflect, { BackgroundTransparency = 0.76 }, 0.38)
        diTweenProp(diReflectGrad, { Offset = Vector2.new(0.12, 0) }, 0.5)
        diTweenProp(diHiStroke, { Transparency = 0.9 }, 0.3)
        diTweenProp(diShadowStroke, { Transparency = 0.86 }, 0.3)
    end

    local diTestUntil = 0
    local diLastRec, diLastSeen = nil, 0
    local function diLooseScan()
        local myChar = LP.Character
        if not myChar then return nil end
        local hrp = myChar:FindFirstChild("HumanoidRootPart")
        if not hrp then return nil end
        local okRole, myRole = pcall(getRole, LP)
        if not okRole or myRole == nil or myRole == "Spectator" then return nil end
        local ok, cands = pcall(collectCandidates, myRole, hrp.Position)
        if not ok or type(cands) ~= "table" then return nil end
        local best
        for _, c in ipairs(cands) do
            if c and c.char and c.head and c.char.Parent then
                if not best or (c.dist or 0) < (best.dist or 0) then best = c end
            end
        end
        return best
    end
    local diLooseAt, diLooseCache = 0, nil
    local function diLooseCached()
        local now = os.clock()
        if now - diLooseAt < 0.2 then return diLooseCache end
        diLooseAt = now
        diLooseCache = diLooseScan()
        return diLooseCache
    end
    local function diPickTarget()
        local mode = _G.AA_IslandMode or "锁定"
        local locked = _G.AA_Target
        if locked and locked.char and locked.char.Parent and locked.head and locked.head.Parent then
            diLastRec, diLastSeen = locked, os.clock()
            _G.AA_IslandLastLock = 0
            return locked
        end
        if mode ~= "锁定" then
            if mode == "视野" then
                local shown = _G.AA_DisplayTarget
                if shown and shown.char and shown.char.Parent and shown.head and shown.head.Parent then
                    return shown
                end
            elseif mode == "任意" then
                local loose = diLooseCached()
                if loose then return loose end
            end
            if _G.AA_IslandFallback == true then
                local shown = _G.AA_DisplayTarget
                if shown and shown.char and shown.char.Parent and shown.head and shown.head.Parent then
                    return shown
                end
                local loose = diLooseCached()
                if loose then return loose end
            end
        end
        if diLastRec and (os.clock() - diLastSeen) < 2
            and diLastRec.char and diLastRec.char.Parent then
            _G.AA_IslandLastLock = math.floor((os.clock() - diLastSeen) * 10) / 10
            return diLastRec
        end
        diLastRec = nil
        _G.AA_IslandLastLock = -1
        return nil
    end

    local function diTest()
        diTestUntil = os.clock() + 3
        diTargetKey = "TEST"
        if diPending then pcall(task.cancel, diPending) diPending = nil end
        diToIsland()
        diName.Text = "灵动岛测试"
        diUser.Text = "@preview"
        diStatus.Text = "测试"
        diStatus.TextColor3 = Color3.fromRGB(150, 230, 160)
        diHpText.Text = "HP 100/100"
        diTweenProp(diBarFill, { Size = UDim2.new(1, 0, 1, 0) }, 0.2)
        diFadeContent(0, 0.15)
        task.delay(3, function()
            if os.clock() >= diTestUntil then diTargetKey = nil diToBall() end
        end)
    end

    local function diValidate(rec)
        if not rec or not rec.char or not rec.char.Parent then return nil end
        local humanoid = rec.char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return nil end
        local player = Players:GetPlayerFromCharacter(rec.char)
        return player, humanoid
    end

    local function diRefresh(rec)
        if not _G.AA_IslandOn then diToBall() return end
        local player, humanoid = diValidate(rec)
        if not humanoid then diToBall() return end
        diToIsland()
        local key = player and ("P" .. tostring(player.UserId)) or ("C" .. tostring(rec.char))
        if key ~= diTargetKey then
            diTargetKey = key
            if diPending then pcall(task.cancel, diPending) diPending = nil end
            diFadeContent(1, 0.1)
            diPending = task.delay(0.13, function()
                if diTargetKey ~= key then diPending = nil return end
                pcall(diApply, rec, player, humanoid)
                pcall(diFadeContent, 0, 0.22)   -- 即使 diApply 出错也强制淡入
                diPending = nil
            end)
        else
            diSetValues(rec, humanoid)
            local locked = (_G.AA_Target == rec)
            local txt = locked and "锁定中" or "目标信息"
            if diStatus.Text ~= txt then
                diStatus.Text = txt
                diStatus.TextColor3 = locked and Color3.fromRGB(150, 230, 160) or Color3.fromRGB(170, 175, 185)
            end
        end
    end

    local diConn = RunService.RenderStepped:Connect(function()
        if diGui and not diGui.Enabled then diGui.Enabled = true end
        if not diGui or not diGui.Parent then
            local okRe = diGui and diTryParents(diGui)
            if okRe and diGui and diGui.Parent then
                _G.AA_Stats.diReattach = (_G.AA_Stats.diReattach or 0) + 1
            end
        end
        local okFrame, errFrame = pcall(function()
            if not _G.AA_IslandOn then diToBall() return end
            if os.clock() < diTestUntil then return end
            local rec = diPickTarget()
            if not rec or not rec.char then diToBall() return end
            local now = os.clock()
            if now - diLastTick < 0.05 then return end
            diLastTick = now
            pcall(diRefresh, rec)
        end)
        if not okFrame then
            _G.AA_Stats.diErr = (_G.AA_Stats.diErr or 0) + 1
            _G.AA_DIErr = tostring(errFrame)
        end
    end)

    local function diDestroy()
        if diConn and diConn.Connected then diConn:Disconnect() end
        if diPending then pcall(task.cancel, diPending) diPending = nil end
        for _, tm in pairs(diTweens) do
            for _, t in pairs(tm) do pcall(function() t:Cancel() end) end
        end
        if diGui and diGui.Parent then diGui:Destroy() end
    end
    _G.AA_DILib = {
        Refresh = diRefresh, Collapse = diToBall, Test = diTest, Destroy = diDestroy,
        Force = function()
            pcall(function()
                diGui.Enabled = true
                diContainer.Visible = true
                if not diGui.Parent then diTryParents(diGui) end
            end)
            diTest()
            return tostring(diGui and diGui.Parent and diGui.Parent.Name or "nil")
        end,
    }
end)
_G.AA_DIOk = okDI and (_G.AA_DILib ~= nil)
if not okDI then _G.AA_DIErr = tostring(errDI) end
if _G.AA_DILib and _G.AA_DIErr == "" then _G.AA_DIErr = "ok" end

