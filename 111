				.. "\n自动射击 " .. (_G.AA_AutoFire and "开" or "关")
				.. " 锁定 " .. (_G.AA_Target and "有" or "无")
				.. " " .. (_G.AA_AutoFireNeedLock and "需锁定" or "自由")
				.. " 间隔 " .. tostring(_G.AA_AutoFireRate) .. "s"
				.. " 预测 " .. (_G.AA_AutoFirePredict and "开" or "关")
				.. " 速 " .. tostring((_G.AA_PredDebug and _G.AA_PredDebug.speed) or 0)
				.. " 提 " .. tostring((_G.AA_PredDebug and _G.AA_PredDebug.lead) or 0)
				.. " 发包 " .. tostring(_G.AA_Stats.autoFire or 0)
				.. " 错误 " .. tostring(_G.AA_Stats.autoFireErr or 0)
				.. " 远程 " .. (_G.AA_GetShoot and _G.AA_GetShoot() and "OK" or "NA"))
		end)
		pcall(function()
			local cd = tonumber(_G.AA_AdminCountdown) or 0
			adminInfoLabel:SetText(tostring(_G.AA_AdminState or "检测中…")
				.. (cd > 0 and (" · 退出倒计时 " .. tostring(cd) .. " 秒") or "")
				.. "\n" .. tostring(_G.AA_AdminList or "—"))
		end)
	end
end)

