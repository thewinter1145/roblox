local function aaLeadTime()
    local t = math.max(0, tonumber(_G.AA_AutoFireLead) or 0)
    if _G.AA_AutoFirePingComp then
        local ok, ping = pcall(function() return LP:GetNetworkPing() end)
        if ok and type(ping) == "number" and ping > 0 and ping < 2 then
            t = t + ping * (tonumber(_G.AA_AutoFirePingScale) or 1)
        end
    end
    if t > 1 then t = 1 end
    return t
end

local function aaClipPred(fromPos, pred, char)
    local d = pred - fromPos
    if d.Magnitude < 0.6 then return pred end
    local params = RaycastParams.new()
    if not pcall(function() params.FilterType = Enum.RaycastFilterType.Exclude end) then
        pcall(function() params.FilterType = Enum.RaycastFilterType.Blacklist end)
    end
    pcall(function() params.RespectCanCollide = true end)
    local ignore = {}
    if LP.Character then table.insert(ignore, LP.Character) end
    if char then table.insert(ignore, char) end
    local cam = workspace.CurrentCamera
    if cam then table.insert(ignore, cam) end
    params.FilterDescendantsInstances = ignore
    local old = _G.AA_InDetectRay
    _G.AA_InDetectRay = true
    local ok, r = pcall(function() return workspace:Raycast(fromPos, d, params) end)
    _G.AA_InDetectRay = old          -- 无条件恢复, 绝不让 namecall hook 长期放行
    if not ok then r = nil end
    if ok and r and r.Instance then
        local stop = r.Distance - 0.3
        if stop < 0 then stop = 0 end
        return fromPos + d.Unit * stop
    end
    return pred
end

local function aaAimPos(t)
    local head = t.head
    local pos = head.Position
    local dbg = _G.AA_PredDebug
    if not dbg then dbg = {}; _G.AA_PredDebug = dbg end
    dbg.speed, dbg.lead = 0, 0
    if not _G.AA_AutoFirePredict then return pos end
    local rec = aaTrack[head]
    local v = (rec and rec.vel) or Vector3.new(0, 0, 0)
    if v.Magnitude < 1.2 then v = aaPhysVel(head) end   -- 未被采样的目标兜底
    if v.Magnitude < 1.2 then return pos end             -- 静止目标无需提前量
    local lead = aaLeadTime()
    if lead <= 0 then return pos end
    local off = v * lead
    local cap = math.max(0, tonumber(_G.AA_AutoFireMaxLead) or 60)
    if off.Magnitude > cap then off = off.Unit * cap end
    local pred = aaClipPred(pos, pos + off, t.char)
    dbg.speed = math.floor(v.Magnitude * 10) / 10
    dbg.lead  = math.floor((pred - pos).Magnitude * 10) / 10
    t._pred = pred
    return pred
end

