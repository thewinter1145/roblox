local STAM_MAX = 1000000
local origStamina = nil

local function stamKeyClass(k)
	local s = tostring(k):lower()
	if not (s:find("stam") or s:find("energy")) then return nil end
	if s:find("drain") or s:find("cost") or s:find("consume")
		or s:find("deplet") or s:find("usage") then return "drain" end
	if s:find("regen") or s:find("recover") or s:find("restore")
		or s:find("replen") then return "regen" end
	if s:find("max") or s:find("cap") or s:find("limit") then return "max" end
	if s:find("min") or s:find("tostart") or s:find("threshold")
		or s:find("required") then return "min" end
	return nil
end

local function patchConfigTable(t, depth, counter)
	if type(t) ~= "table" or depth > 3 then return counter end
	for k, v in pairs(t) do
		if counter > 200 then return counter end
		local cls = stamKeyClass(k)
		if cls and type(v) == "number" then
			local nv = (cls == "drain" or cls == "min") and 0 or STAM_MAX
			pcall(function() rawset(t, k, nv) end)
			counter = counter + 1
		elseif type(v) == "table" then
			counter = patchConfigTable(v, depth + 1, counter)
		end
	end
	return counter
end

local function getMovementConfig()
	local ok, M = pcall(function()
		local shared = game:GetService("ReplicatedStorage"):FindFirstChild("Shared")
		local mod = shared and shared:FindFirstChild("MovementConfig")
		return mod and require(mod)
	end)
	if ok and type(M) == "table" then return M end
	return nil
end

local function applyInfiniteStamina()
	local M = getMovementConfig()
	if not M then _G.AA_Stats.stamina = false; return false end
	local S = type(M.Sprint) == "table" and M.Sprint or M

	if not origStamina and type(S) == "table" then
		origStamina = { t = S,
			DrainPerSecond = S.DrainPerSecond, StaminaMax = S.StaminaMax,
			RegenPerSecond = S.RegenPerSecond, MinToStart = S.MinToStart }
	end

	pcall(function() rawset(S, "DrainPerSecond", 0) end)
	pcall(function() rawset(S, "StaminaMax", STAM_MAX) end)
	pcall(function() rawset(S, "RegenPerSecond", STAM_MAX) end)
	pcall(function() rawset(S, "MinToStart", 0) end)
	pcall(function() rawset(M, "DrainPerSecond", 0) end)
	pcall(function() rawset(M, "StaminaMax", STAM_MAX) end)
	pcall(function() rawset(M, "RegenPerSecond", STAM_MAX) end)
	_G.AA_Stats.staminaPatched = patchConfigTable(M, 0, 0)
	_G.AA_Stats.stamina = true
	return true
end

local function restoreStaminaConfig()
	if not origStamina then return end
	local t = origStamina.t
	for _, k in ipairs({ "DrainPerSecond", "StaminaMax", "RegenPerSecond", "MinToStart" }) do
		if origStamina[k] ~= nil then
			pcall(function() rawset(t, k, origStamina[k]) end)
		end
	end
	origStamina = nil
end

local staminaSlots = {}
local function looksLikeStamina(name)
	local s = tostring(name):lower()
	return s:find("stam") ~= nil or s:find("energy") ~= nil
end
local function scanStaminaSlots()
	local found = {}
	local roots = { LP }
	local ch = LP.Character
	if ch then
		table.insert(roots, ch)
		local hum = ch:FindFirstChildOfClass("Humanoid")
		if hum then table.insert(roots, hum) end
	end
	for _, root in ipairs(roots) do
		if root then
			pcall(function()
				for k, v in pairs(root:GetAttributes()) do
					if type(v) == "number" and looksLikeStamina(k) then
						table.insert(found, { obj = root, kind = "attr", key = k, max = math.max(v, STAM_MAX) })
					end
				end
			end)
			pcall(function()
				for _, c in ipairs(root:GetChildren()) do
					if (c:IsA("NumberValue") or c:IsA("IntValue")) and looksLikeStamina(c.Name) then
						table.insert(found, { obj = c, kind = "value", key = "Value", max = math.max(c.Value, STAM_MAX) })
					end
				end
			end)
		end
	end
	return found
end

if _G.AA_Stamina then pcall(applyInfiniteStamina) end
staminaSlots = scanStaminaSlots()
_G.AA_Stats.staminaSlots = #staminaSlots

task.spawn(function()
	local cfgClock, scanClock = 0, 0
	while true do
		local dt = task.wait(0.05)
		if not _G.AA_Stamina then cfgClock, scanClock = 0, 0; continue end
		for _, s in ipairs(staminaSlots) do
			pcall(function()
				if s.kind == "attr" then
					local cur = s.obj:GetAttribute(s.key)
					if type(cur) == "number" and cur < s.max then s.obj:SetAttribute(s.key, s.max) end
				else
					if s.obj.Value < s.max then s.obj.Value = s.max end
				end
			end)
		end
		cfgClock = cfgClock + dt
		if cfgClock >= 0.25 then cfgClock = 0; pcall(applyInfiniteStamina) end
		scanClock = scanClock + dt
		if scanClock >= 2 then
			scanClock = 0
			local f = scanStaminaSlots()
			if #f > 0 then staminaSlots = f end
			_G.AA_Stats.staminaSlots = #staminaSlots
			pcall(applyInfiniteStamina)
		end
	end
end)

local function getRole(p) return p:GetAttribute("Role") end

local function hostileLevel(myRole, otherRole)
