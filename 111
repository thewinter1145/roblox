local function collectCandidates(myRole, myPos)
	local cands = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= LP and p.Character then
			table.insert(cands, { char = p.Character, role = getRole(p) })
		end
	end
	for _, e in ipairs(NPC_cache) do table.insert(cands, e) end

	local filtered = {}
	for _, c in ipairs(cands) do
		local ch = c.char
		if ch == LP.Character then continue end
		local role = c.role
		if role == "Spectator" then continue end
		local lvl = hostileLevel(myRole, role)
		if lvl == false then continue end
		local hum = ch:FindFirstChildOfClass("Humanoid")
		if not hum or hum.Health <= 0 then continue end
		local ap = aimPoint(ch)
		if not ap then continue end
		local d = (ap.Position - myPos).Magnitude
		if d > _G.AA_MaxDist then continue end
		table.insert(filtered, { head = ap, char = ch, role = role, dist = d, sure = (lvl == true) })
	end
	return filtered
end

local function fovRadiusPx()
	local c = workspace.CurrentCamera or cam
	if not c then return nil, nil, nil end
	local ok, vp = pcall(function() return c.ViewportSize end)
	if not ok or not vp then return nil, nil, nil end
	local pxPerDeg = vp.Y / math.max(1, c.FieldOfView)
	return (_G.AA_FOV / 2) * pxPerDeg, vp, c
end

local function screenInFOV(worldPos)
	if _G.AA_FOV >= 359 then return true end
	local r, vp, c = fovRadiusPx()
	if not r or not vp or not c then return true end
	local ok, v = pcall(function() return c:WorldToViewportPoint(worldPos) end)
	if not ok or not v or v.Z <= 0 then return false end
	local dx, dy = v.X - vp.X / 2, v.Y - vp.Y / 2
	return (dx * dx + dy * dy) <= (r * r)
end

local function findTarget()
	local myChar = LP.Character
	if not myChar then return nil end
	local myRole = getRole(LP)
	if myRole == nil or myRole == "Spectator" then return nil end
	local hrp = myChar:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local myPos = hrp.Position
	local okCC, filtered = pcall(collectCandidates, myRole, myPos)
	if not okCC or type(filtered) ~= "table" then return nil end
	if not cam then return nil end
    local best
    for _, c in ipairs(filtered) do
        if not c or not c.head then continue end
        local okF, inF = pcall(screenInFOV, c.head.Position)
        if not okF or not inF then continue end
        if _G.AA_ExposedOnly then
            local okE, ex = pcall(isExposed, c.head, c.char)
            if not okE or not ex then continue end
        end
        if not best then
            best = c
        elseif c.sure and not best.sure then
            best = c
        elseif c.sure == best.sure and c.dist < best.dist then
            best = c
        end
    end
	return best
end

local function findDisplayTarget()
	local myChar = LP.Character
	if not myChar then return nil end
	local myRole = getRole(LP)
	if myRole == nil or myRole == "Spectator" then return nil end
	local hrp = myChar:FindFirstChild("HumanoidRootPart")
	if not hrp or not cam then return nil end
	local ok, cands = pcall(collectCandidates, myRole, hrp.Position)
	if not ok or type(cands) ~= "table" then return nil end
	local best
	for _, c in ipairs(cands) do
		if not screenInFOV(c.head.Position) then continue end
		local okE, exposed = pcall(isExposed, c.head, c.char)
		if okE and not exposed then continue end
		if not best or c.dist < best.dist then best = c end
	end
	return best
end

