-- Origin: 枪口 (与抓包 Origin 一致) -> 自己头部 -> 相机
local function aaOrigin()
    if _G.AA_RayFromMuzzle then
        local ok, p = pcall(muzzleWorldPos)
        if ok and p then return p end
    end
    local ch = LP.Character
    local h = ch and ch:FindFirstChild("Head", true)
    if h and h:IsA("BasePart") then return h.Position end
    local c = workspace.CurrentCamera
    if c then return c.CFrame.Position end
    return nil
end

-- 可见性: 强制复用 isExposed, 保证不隔墙(不受面板 ExposedOnly 影响)
local function aaVisible(t)
    if not _G.AA_AutoFireWallCheck then return true end
    local ok, ex = pcall(isExposed, t.head, t.char)
    return ok and ex == true
end

-- 自身 Role 为 nil / Spectator 时 findTarget 会返回 nil -> 宽松兜底
local aaRelaxWarned = false
local function aaRelaxTarget(origin)
    local mine = getRole(LP)
    if mine and mine ~= "Spectator" then return nil end
    local best
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP or not p.Character then continue end
        local role = getRole(p)
        if role == "Spectator" then continue end
        if LP.Team and p.Team and LP.Team == p.Team then continue end
        local ch = p.Character
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        local head = aimPoint(ch)
        if not head or not head:IsA("BasePart") then continue end
        local d = (head.Position - origin).Magnitude
        if d > _G.AA_MaxDist then continue end
        local okF, inF = pcall(screenInFOV, head.Position)
        if not okF or not inF then continue end
        local t = { head = head, char = ch, role = role, dist = d, sure = false }
        if aaVisible(t) and (not best or d < best.dist) then best = t end
    end
    if best and not aaRelaxWarned then
        aaRelaxWarned = true
        warn("[自动射击] 自身阵营未识别, 已启用宽松兜底(可能误伤), 可在面板关闭")
    end
    return best
end

-- 取目标: 默认"被锁定才攻击"
--   _G.AA_Target 由 RenderStepped 主循环的 findTarget() 每帧产生,
--   已通过 队伍检测 / FOV / 可见性 / 距离 / 存活 过滤 (灵动岛"锁定中"即此目标)
local function aaTargets(origin)
    local n = math.max(1, math.floor(_G.AA_AutoFireTargets or 1))

    if _G.AA_AutoFireNeedLock then
        -- 总开关未开时主循环不会锁定目标 -> 停火
        if not _G.AA_Enabled then return {} end
        local locked = _G.AA_Target
        if not locked or not locked.head or not locked.head.Parent
            or not locked.char or not locked.char.Parent then return {} end
        if not aaVisible(locked) then return {} end   -- 不隔墙双保险

        if n == 1 then return { locked } end
        -- 多目标: 以锁定目标为首, 其余从 collectCandidates 补(同一套队伍检测)
        local list = { locked }
        local ch = LP.Character
        local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
        local ok, cands = pcall(collectCandidates, getRole(LP), hrp and hrp.Position or origin)
        if ok and type(cands) == "table" then
            table.sort(cands, function(a, b) return (a.dist or 9e9) < (b.dist or 9e9) end)
            for _, c in ipairs(cands) do
                if #list >= n then break end
                if c.char == locked.char then continue end
                local okF, inF = pcall(screenInFOV, c.head.Position)
                if okF and inF and aaVisible(c) then table.insert(list, c) end
            end
        end
        return list
    end

    -- 关闭"被锁定才攻击"时: 沿用旧的独立寻找逻辑(可脱离总开关工作)
    local primary
    if _G.AA_Enabled then
        primary = _G.AA_Target
    else
        local ok, r = pcall(findTarget)
        if ok then primary = r end
    end
    if not primary and _G.AA_AutoFireRelax then primary = aaRelaxTarget(origin) end
    if n == 1 then
        return (primary and aaVisible(primary)) and { primary } or {}
    end
    local list = {}
    local ch = LP.Character
    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
    local ok, cands = pcall(collectCandidates, getRole(LP), hrp and hrp.Position or origin)
    if ok and type(cands) == "table" then
        table.sort(cands, function(a, b) return (a.dist or 9e9) < (b.dist or 9e9) end)
        for _, c in ipairs(cands) do
            if #list >= n then break end
            local okF, inF = pcall(screenInFOV, c.head.Position)
            if okF and inF and aaVisible(c) then table.insert(list, c) end
        end
    end
    if #list == 0 and primary and aaVisible(primary) then table.insert(list, primary) end
    if #list == 0 and _G.AA_AutoFireRelax then
        local r = aaRelaxTarget(origin)
        if r then table.insert(list, r) end
    end
    return list
end

--====================================================================--
-- 运动预测: 把射线指向目标的"未来位置", 解决移动目标打不中
--   采样与发射节流解耦(独立 Heartbeat 每帧采样), 长间隔下速度依然连续
--   提前时间 = 手动提前量 + 网络延迟(ping) * 系数
--   速度 = 帧差(指数平滑) 与 引擎线速度 取模较大者; 瞬移/重生会限幅剔除
--   预测点落在掩体后时自动截断到墙前, 不把射线瞄进墙里
--====================================================================--
local aaTrack = setmetatable({}, { __mode = "k" })   -- 弱键, 目标销毁自动回收

local function aaPhysVel(part)
    local best = Vector3.new(0, 0, 0)
    pcall(function()
        local a = part.AssemblyLinearVelocity
        if typeof(a) == "Vector3" and a.Magnitude > best.Magnitude then best = a end
    end)
    pcall(function()
        local b = part.Velocity
        if typeof(b) == "Vector3" and b.Magnitude > best.Magnitude then best = b end
    end)
    return best
end

local function aaSample(part)
    if not part or not part.Parent then return end
    local now = os.clock()
    local pos = part.Position
    local rec = aaTrack[part]
    if not rec then
        aaTrack[part] = { pos = pos, t = now, vel = Vector3.new(0, 0, 0) }
        return
    end
    local dt = now - rec.t
    local raw = Vector3.new(0, 0, 0)
    if dt > 0.004 and dt < 0.5 then raw = (pos - rec.pos) / dt end
    local phys = aaPhysVel(part)
    if phys.Magnitude > raw.Magnitude then raw = phys end
    if raw.Magnitude > 150 then raw = Vector3.new(0, 0, 0) end   -- 瞬移/重生剔除
    local a = tonumber(_G.AA_AutoFireSmooth) or 0.35
    if a < 0.02 then a = 0.02 elseif a > 1 then a = 1 end
    local v = rec.vel + (raw - rec.vel) * a
    if v.Magnitude < 1.2 then v = Vector3.new(0, 0, 0) end       -- 静止死区
    rec.pos, rec.t, rec.vel = pos, now, v
end

-- 每帧采样锁定目标(与"射击间隔"无关, 否则 0.5s 间隔下速度会严重失真)
