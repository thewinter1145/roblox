-- 发包: 保持协议长度, 只把方向指向预测位置
local function aaFire(origin, targets)
    local shots = {}
    for _, t in ipairs(targets) do
        if not t.head or not t.head.Parent then continue end
        local aim = aaAimPos(t)
        local dir = (aim - origin).Unit
        local endPos
        if _G.AA_AutoFireEndMode == "命中点" then
            endPos = aim
        else
            endPos = origin + dir * (_G.AA_AutoFireRayLen or 1000)
        end
        table.insert(shots, { Origin = origin, EndPosition = endPos })
        t._end = endPos
    end
    if #shots == 0 then return false end
    AA_Shoot:FireServer(shots)
    return true
end

local function aaTracer(a, b)
    if not _G.AA_AutoFireTracer then return end
    local len = (b - a).Magnitude
    if len < 0.1 then return end
    local p = Instance.new("Part")
    p.Name = "AA_AutoFireTracer"
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.CastShadow = false
    p.Material = Enum.Material.Neon
    p.Color = Color3.fromRGB(255, 60, 60)
    p.Size = Vector3.new(0.06, 0.06, len)
    p.CFrame = CFrame.lookAt((a + b) / 2, b)
    p.Parent = workspace
    game:GetService("Debris"):AddItem(p, 0.06)
end

