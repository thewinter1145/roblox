	if p.Character then onChar(p.Character) end
	pcall(function() p.CharacterAdded:Connect(onChar) end)
	pcall(function()
		p.CharacterRemoving:Connect(function(ch)
			if ch then destroyESP(ch) end
		end)
	end)
	pcall(function()
		p:GetAttributeChangedSignal("Role"):Connect(function()
			local ch = p.Character
			if ch and esp[ch] then
				destroyESP(ch)
				pcall(makeESP, ch, p)
			end
		end)
	end)
end

