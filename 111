local ESP_RESCAN_INTERVAL = 5
local espRescanClock = 0
_G.AA_ESPRs = RunService.Heartbeat:Connect(function(dt)
	local on = _G.AA_ESPOn
	for char, rec in pairs(esp) do
		if not on or not (char and char.Parent) then
			destroyESP(char)
		else
			local ok, hp, maxhp = pcall(function() return rec.hum.Health, rec.hum.MaxHealth end)
			if ok and maxhp and maxhp > 0 then
				rec.hpText.Text = math.floor(hp) .. " / " .. math.floor(maxhp)
			end
		end
	end
	if not on then
		espRescanClock = 0
		return
	end
	espRescanClock = espRescanClock + (dt or 0)
	if espRescanClock >= ESP_RESCAN_INTERVAL then
		espRescanClock = 0
		pcall(sweepESPOrphans)
		for _, p in ipairs(Players:GetPlayers()) do
			if p == LP then continue end
			if p.Character and not esp[p.Character] then
				task.defer(function() pcall(makeESP, p.Character, p) end)
			end
		end
	end
end)

