	if myRole == "Police" and otherRole == "Criminal" then return true end
	if myRole == "Criminal" and otherRole == "Police" then return true end
	if _G.AA_EnemyOnly then return false end
	if otherRole == "Civilian" then return "maybe" end
	if otherRole == nil then return _G.AA_Strict and false or "maybe" end
	if _G.AA_Aggro then return "maybe" end
