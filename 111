local function destroyESP(char)
	local rec = esp[char]
	if not rec then return end
	pcall(function() rec.bg:Destroy() end)
	pcall(function() rec.hl:Destroy() end)
	if rec.boxes then
		for _, b in ipairs(rec.boxes) do pcall(function() b:Destroy() end) end
	end
	esp[char] = nil
end

local function sweepESPOrphans()
	if not espHolder or not espHolder.Parent then return end
	local live = {}
	for _, rec in pairs(esp) do
		if rec.hl then live[rec.hl] = true end
		if rec.boxes then
			for _, b in ipairs(rec.boxes) do live[b] = true end
		end
	end
	local ok, kids = pcall(function() return espHolder:GetChildren() end)
	if not ok or not kids then return end
	for _, obj in ipairs(kids) do
		if not live[obj] then pcall(function() obj:Destroy() end) end
	end
end

local function espWallRoleAllowed(role)
    if _G.AA_ESPWall == false then return false end
    local t = _G.AA_ESPWallRoles
    if type(t) ~= "table" then return true end
    if role == nil then return true end
    return t[role] ~= false
end
local function makeESP(char, player)
	if esp[char] then return end
	if not char or not char.Parent then return end
	local ad = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not ad or not hum then return end
	local role = nil
	if player then role = player:GetAttribute("Role") end
	if not role then role = char:GetAttribute("Role") end
	if not role then return end
	local info = roleInfo(role)
	local name = player and player.Name or char.Name

	local bg = Instance.new("BillboardGui")
	bg.Name = "ESP_Billboard"
	bg.Adornee = ad
	bg.Size = UDim2.new(0, 200, 0, 40)
	bg.StudsOffset = Vector3.new(0, 1.2, 0)
	bg.AlwaysOnTop = espWallRoleAllowed(role)
	bg.ResetOnSpawn = false

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0.6, 0)
	label.BackgroundTransparency = 1
	label.Text = name .. " [" .. info.name .. "]"
	label.TextColor3 = info.color
	label.TextStrokeTransparency = 0.4
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextScaled = false
	label.TextSize = 14
	label.Font = Enum.Font.SourceSansBold
	label.Parent = bg

	local hpText = Instance.new("TextLabel")
	hpText.Size = UDim2.new(1, 0, 0.4, 0)
	hpText.Position = UDim2.new(0, 0, 0.6, 0)
	hpText.BackgroundTransparency = 1
	hpText.TextColor3 = Color3.new(1, 1, 1)
	hpText.TextStrokeTransparency = 0.4
	hpText.TextStrokeColor3 = Color3.new(0, 0, 0)
	hpText.TextScaled = false
	hpText.TextSize = 12
	hpText.Font = Enum.Font.SourceSans
	hpText.Parent = bg

	bg.Parent = ad

	local holder = getESPHolder()
	local wallOn = espWallRoleAllowed(role)
	local mode = _G.AA_ChamsMode or "Both"
	local fill = tonumber(_G.AA_ChamsFill) or 0.6
	local outline = tonumber(_G.AA_ChamsOutline) or 0.05

	local hl = Instance.new("Highlight")
	hl.Name = "ESP_Highlight"
	hl.Adornee = char
	hl.FillColor = info.color
	hl.OutlineColor = info.color
	hl.FillTransparency = fill
	hl.OutlineTransparency = outline
	hl.DepthMode = wallOn and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
	hl.Enabled = (mode ~= "BoxHandles")
	hl.Parent = holder

	local boxes = {}
	for _, part in ipairs(char:GetChildren()) do
		if part:IsA("BasePart") and (part.Name == "Head" or part.Name:find("Arm") or part.Name:find("Leg") or part.Name:find("Hand") or part.Name:find("Torso") or part.Name:find("Foot")) then
			local box
			if part.Name == "Head" then
				box = Instance.new("SphereHandleAdornment")
				box.Radius = 0.75
			else
				box = Instance.new("BoxHandleAdornment")
				box.Size = part.Size
			end
			box.Name = "AA_Cham"
			box.Adornee = part
			box.AlwaysOnTop = wallOn
			box.ZIndex = 0
			box.Transparency = fill
			box.Color3 = info.color
			box.Visible = (mode == "BoxHandles" or mode == "Both")
			box.Parent = holder
			table.insert(boxes, box)
		end
	end

	esp[char] = { bg = bg, hpText = hpText, hl = hl, boxes = boxes, hum = hum, color = info.color, role = role }
	_G.AA_Stats.esp = _G.AA_Stats.esp + 1
end

